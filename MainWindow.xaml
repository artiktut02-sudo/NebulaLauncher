<Window x:Class="NebulaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula Launcher" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F13"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9061F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F4E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F1F26"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F0F13" Offset="0.0"/>
                <GradientStop Color="#181824" Offset="0.5"/>
                <GradientStop Color="#0F0F13" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#15151C" BorderBrush="#252530" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="N" FontSize="30" FontWeight="Black" Foreground="#7C3AED" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                <Button Content="🎮" Style="{StaticResource IconBtn}" Margin="15,0,15,10" Background="#1F1F26" Foreground="White"/>
                <Button Content="🧩" Style="{StaticResource IconBtn}" Margin="15,0,15,10" Click="ModsBtn_Click" ToolTip="Моды"/>
                <Button Content="⚙️" Style="{StaticResource IconBtn}" Margin="15,0,15,10"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="50,40,50,40">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="Статус:" FontSize="10" Foreground="#666666" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="StatusText" Text="Запуск..." FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                    <ProgressBar x:Name="DownloadBar" Height="4" Width="150" Margin="0,5,0,0" Foreground="#7C3AED" Background="#2A2A35" BorderThickness="0" Visibility="Collapsed"/>
                </StackPanel>
                <Border Background="#1F1F26" CornerRadius="15" Padding="10,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="NickBox" Text="Steve" Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold" Width="80" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" Margin="0,50,0,0">
                <TextBlock Text="◀ НАЗАД" FontSize="12" Foreground="#888888" Margin="0,0,0,20"/>
                <TextBlock Text="CLASSIC" FontSize="72" FontWeight="Black" Foreground="White" Margin="0,0,0,10"/>
                <TextBlock Text="Классический Майнкрафт." FontSize="16" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                <TextBlock Text="Выберите версию игры ниже, чтобы начать." FontSize="14" Foreground="#666666" Margin="0,0,0,30" MaxWidth="400" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                <ComboBox x:Name="VersionBox" Width="200" Height="35" FontSize="14" Background="#1F1F26" Foreground="Black" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,30"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayBtn" Content="▶ ИГРАТЬ" Style="{StaticResource PrimaryBtn}" Click="PlayBtn_Click" Margin="0,0,15,0" Width="140"/>
                    <Button Content="⚙️ НАСТРОЙКИ" Style="{StaticResource SecondaryBtn}" Width="160"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="📦 СПИСОК МОДОВ" FontSize="12" Foreground="#666666" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
            <TextBlock Text="🎧 НАШ САЙТ" FontSize="12" Foreground="#666666" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
