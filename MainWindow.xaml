<Window x:Class="NebulaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula Launcher" Height="520" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#12121A"
        Foreground="White"
        FontFamily="Segoe UI">
    
    <!-- Стили для контролов -->
    <Window.Resources>
        <!-- Красивое текстовое поле -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderThickness="1" 
                                BorderBrush="#3A3A45">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#353542"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Красивая кнопка -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9061F9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#5B21B6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3A3A45"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Фон с градиентом -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F0C20" Offset="0.0"/>
                <GradientStop Color="#1E1E2E" Offset="0.5"/>
                <GradientStop Color="#12121A" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Margin="30" VerticalAlignment="Center">
            <!-- Заголовок -->
            <TextBlock Text="NEBULA LAUNCHER" FontSize="32" FontWeight="Black"
                       Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,0,0,5">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Твой путь в Майнкрафт" FontSize="12" Foreground="#666666" 
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <!-- Ник -->
            <TextBlock Text="Ник" FontSize="13" Foreground="#A0A0A0" Margin="0,0,0,6"/>
            <TextBox x:Name="NickBox" Text="Steve" Margin="0,0,0,15"/>

            <!-- Версия -->
            <TextBlock Text="Версия" FontSize="13" Foreground="#A0A0A0" Margin="0,0,0,6"/>
            <!-- Оставляем стандартный ComboBox, но делаем его чуть темнее -->
            <ComboBox x:Name="VersionBox" FontSize="14" Padding="8" Margin="0,0,0,25"
                      Background="#2A2A35" Foreground="Black"/>

            <!-- Кнопка Играть -->
            <Button x:Name="PlayBtn" Content="ИГРАТЬ" Height="50" Click="PlayBtn_Click"/>

            <!-- Прогресс-бар (скрыт по умолчанию) -->
            <ProgressBar x:Name="DownloadBar" Height="6" Margin="0,15,0,0" 
                         Foreground="#A78BFA" Background="#2A2A35"
                         BorderThickness="0" Visibility="Collapsed"/>

            <!-- Статус -->
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="#A78BFA" 
                       HorizontalAlignment="Center" Margin="0,15,0,0" Text="Готов к запуску"/>
        </StackPanel>
    </Grid>
</Window>
