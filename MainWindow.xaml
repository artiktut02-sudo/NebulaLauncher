<Window x:Class="NebulaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula Launcher" Height="600" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Стили для кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#6D28D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8B5CF6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#5B21B6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для темных кнопок (Моды, Настройки) -->
        <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1F1F1F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F2F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- КОСМИЧЕСКИЙ ФОН (Градиент, имитирующий туманность) -->
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1.0" RadiusY="1.0">
                <GradientStop Color="#1A0B2E" Offset="0.0"/>
                <GradientStop Color="#0B0416" Offset="0.6"/>
                <GradientStop Color="#000000" Offset="1.0"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Звезды на фоне -->
        <Canvas>
            <Ellipse Width="2" Height="2" Fill="White" Opacity="0.8" Canvas.Left="120" Canvas.Top="50"/>
            <Ellipse Width="1.5" Height="1.5" Fill="White" Opacity="0.5" Canvas.Left="300" Canvas.Top="150"/>
            <Ellipse Width="2" Height="2" Fill="White" Opacity="0.9" Canvas.Left="600" Canvas.Top="80"/>
            <Ellipse Width="1" Height="1" Fill="White" Opacity="0.4" Canvas.Left="750" Canvas.Top="300"/>
            <Ellipse Width="2" Height="2" Fill="White" Opacity="0.7" Canvas.Left="80" Canvas.Top="450"/>
            <Ellipse Width="1.5" Height="1.5" Fill="White" Opacity="0.6" Canvas.Left="450" Canvas.Top="400"/>
            <Ellipse Width="2" Height="2" Fill="White" Opacity="0.8" Canvas.Left="200" Canvas.Top="250"/>
            <Ellipse Width="1" Height="1" Fill="White" Opacity="0.5" Canvas.Left="680" Canvas.Top="520"/>
        </Canvas>

        <!-- Основная сетка -->
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель (Аватар + Меню) -->
            <Border Grid.Column="0" Background="#151515" CornerRadius="15" Padding="20" Margin="0,0,20,0" BorderBrush="#2A2A35" BorderThickness="1">
                <StackPanel>
                    <!-- Аватарка (Фиолетовый круг с буквой) -->
                    <Grid Width="100" Height="100" HorizontalAlignment="Center" Margin="0,20,0,15">
                        <Ellipse Fill="#6D28D9">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="25" ShadowDepth="0" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="N" FontSize="50" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <TextBlock Text="ENJOTA" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    
                    <!-- Меню -->
                    <Button Content="🎮 ИГРАТЬ" Height="45" Margin="0,0,0,10"/>
                    <Button Content="🧩 МОДЫ" Height="45" Margin="0,0,0,10" Style="{StaticResource DarkButton}"/>
                    <Button Content="⚙️ НАСТРОЙКИ" Height="45" Style="{StaticResource DarkButton}"/>
                </StackPanel>
            </Border>

            <!-- Правая панель (Логин и запуск) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0,40,0">
                <TextBlock Text="NEBULA LAUNCHER" FontSize="52" FontWeight="Black" Foreground="#A78BFA" Margin="0,0,0,5">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#6D28D9" BlurRadius="25" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Твой путь в бесконечность" FontSize="16" Foreground="#888888" Margin="0,0,0,40"/>

                <TextBlock Text="Никнейм" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                <TextBox x:Name="NickBox" Text="Steve" FontSize="16" Padding="10" Background="#151515" Foreground="White" BorderThickness="1" BorderBrush="#333333" Margin="0,0,0,20"/>

                <TextBlock Text="Версия Minecraft" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                <ComboBox x:Name="VersionBox" FontSize="16" Padding="10" Background="#151515" Foreground="Black" Margin="0,0,0,30"/>

                <Button x:Name="PlayBtn" Content="ИГРАТЬ" Height="60" FontSize="20" Click="PlayBtn_Click"/>
                
                <ProgressBar x:Name="DownloadBar" Height="8" Margin="0,20,0,0" Foreground="#8B5CF6" Background="#151515" BorderThickness="0" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" FontSize="14" Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,15,0,0" Text="Готов к запуску"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
